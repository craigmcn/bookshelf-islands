<%= form_with(model: reading) do |form| %>
  <% if reading.errors.any? %>
    <div class="alert alert-danger">
      <strong><%= pluralize(reading.errors.count, "error") %> prevented this reading from being saved:</strong>
      <ul class="mb-0 mt-1">
        <% reading.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-3">
    <%= form.label :book_id, "Book", class: "form-label" %>
    <%= form.collection_select :book_id, Book.order(:title), :id, :title,
          { prompt: "Select a book" }, { class: "form-select" } %>
  </div>

  <div class="mb-3">
    <%= form.label :status, class: "form-label" %>
    <%= form.select :status, Reading.status_options,
          { prompt: "Select a status" }, { class: "form-select" } %>
  </div>

  <div class="mb-3">
    <%= form.label :format, class: "form-label" %>
    <%= form.select :format, Reading.formats.keys.map { |f| [f.humanize, f] },
          { include_blank: "Not specified" }, { class: "form-select" } %>
  </div>

  <div class="row mb-3">
    <div class="col">
      <%= form.label :started_on, "Started", class: "form-label" %>
      <%= form.date_field :started_on, class: "form-control" %>
    </div>
    <div class="col">
      <%= form.label :finished_on, "Finished", class: "form-label" %>
      <%= form.date_field :finished_on, class: "form-control" %>
    </div>
  </div>

  <div class="mb-3" data-controller="rating"
       data-rating-options-value="<%= Reading.ratings.map { |key, value| {key: key, value: value, label: key.humanize} }.to_json %>">
    <%= form.label :rating, class: "form-label d-block" %>
    <%= form.hidden_field :rating, data: { rating_target: "input" } %>
    <div data-rating-target="root"></div>
  </div>

  <div class="mb-3" data-controller="progress">
    <%= form.label :progress_percent, "Progress", class: "form-label d-block" %>
    <%= form.hidden_field :progress_percent, data: { progress_target: "input" } %>
    <div data-progress-target="root"></div>
  </div>

  <div class="mb-3">
    <%= form.label :review, class: "form-label" %>
    <%= form.textarea :review, class: "form-control", rows: 4, placeholder: "What did you think?" %>
  </div>

  <div class="mb-3" data-controller="privacy-toggle">
    <%= form.hidden_field :is_review_public, data: { privacy_toggle_target: "input" } %>
    <div data-privacy-toggle-target="root"></div>
  </div>

  <div class="d-flex gap-2">
    <%= form.submit class: "btn btn-primary" %>
    <%= link_to "Cancel", readings_path, class: "btn btn-outline-secondary" %>
  </div>
<% end %>
