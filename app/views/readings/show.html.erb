<% content_for :title, @reading.book.title %>

<div class="card">
  <div class="card-body">
    <div class="d-flex align-items-center gap-2 mb-1">
      <h2 class="card-title mb-0"><%= @reading.book.title %></h2>
      <% if @reading.deleted? %>
        <span class="badge bg-danger">Deleted</span>
      <% end %>
    </div>
    <p class="text-muted"><%= @reading.book.author %></p>

    <dl class="row mt-3">
      <dt class="col-sm-2">Status</dt>
      <dd class="col-sm-10">
        <%
          status_icon = case @reading.status
                        when "want_to_read" then "fa-bookmark"
                        when "reading"      then "fa-book-open-reader"
                        when "finished"     then "fa-circle-check"
                        when "dnf"          then "fa-circle-xmark"
                        end
        %>
        <span class="badge badge-status-<%= @reading.status.tr('_', '-') %>">
          <i class="fasl <%= status_icon %> me-1"></i><%= @reading.status_label %>
        </span>
      </dd>

      <% if @reading.format.present? %>
        <dt class="col-sm-2">Format</dt>
        <dd class="col-sm-10"><%= @reading.format.humanize %></dd>
      <% end %>

      <% if @reading.started_on.present? || @reading.finished_on.present? %>
        <dt class="col-sm-2">Dates</dt>
        <dd class="col-sm-10">
          <% if @reading.started_on.present? %>Started <%= @reading.started_on.to_fs(:long) %><% end %>
          <% if @reading.started_on.present? && @reading.finished_on.present? %> &middot; <% end %>
          <% if @reading.finished_on.present? %>Finished <%= @reading.finished_on.to_fs(:long) %><% end %>
        </dd>
      <% end %>

      <% if @reading.progress_percent.present? %>
        <dt class="col-sm-2">Progress</dt>
        <dd class="col-sm-10">
          <div class="progress" style="height: 0.5rem; max-width: 300px;">
            <div class="progress-bar" role="progressbar" style="width: <%= @reading.progress_percent %>%"
                 aria-label="Reading progress"
                 aria-valuenow="<%= @reading.progress_percent %>" aria-valuemin="0" aria-valuemax="100"></div>
          </div>
          <span class="text-muted small"><%= @reading.progress_percent %>%</span>
        </dd>
      <% end %>

      <dt class="col-sm-2">Rating</dt>
      <dd class="col-sm-10">
        <% if @reading.rating %>
          <span class="visually-hidden"><%= @reading.rating.humanize %></span>
          <% Reading.ratings[@reading.rating].times do %>
            <i class="fasl fa-star text-warning" aria-hidden="true"></i>
          <% end %>
        <% else %>
          —
        <% end %>
      </dd>

      <% if @reading.review.present? %>
        <dt class="col-sm-2">Review</dt>
        <dd class="col-sm-10">
          <%= @reading.review %>
          <span class="badge <%= @reading.is_review_public? ? "text-bg-secondary" : "text-bg-warning" %> ms-2">
            <%= @reading.is_review_public? ? "Public" : "Private" %>
          </span>
        </dd>
      <% end %>
    </dl>

    <% if @reading.is_review_public? && @reading.review.present? %>
      <div class="mt-3" data-controller="review-like"
           data-review-like-url-value="<%= reading_review_like_path(@reading) %>"
           data-review-like-liked-value="<%= @reading.review_likes.exists?(user: current_user) %>"
           data-review-like-count-value="<%= @reading.review_likes.count %>"
           data-review-like-can-like-value="<%= policy(ReviewLike.new(reading: @reading)).create? %>">
        <div data-review-like-target="root"></div>
      </div>

      <hr class="my-4">
      <h3 class="h5"><i class="fasl fa-comments me-2 opacity-75"></i>Comments</h3>
      <div data-controller="review-comments"
           data-review-comments-url-value="<%= reading_review_comments_path(@reading) %>"
           data-review-comments-can-comment-value="<%= policy(ReviewComment.new(reading: @reading)).create? %>"
           data-review-comments-comments-value="<%= @review_comments.map { |c|
             {
               id: c.id, body: c.body, created_at: c.created_at.iso8601,
               author_name: c.user.display_name, author_path: user_path(c.user),
               can_destroy: policy(c).destroy?, delete_path: reading_review_comment_path(@reading, c)
             }
           }.to_json %>">
        <div data-review-comments-target="root"></div>
      </div>
    <% end %>

    <div class="d-flex gap-2 mt-3">
      <% if current_user&.moderator_or_above? %>
        <%= link_to admin_readings_path, class: "btn btn-outline-secondary" do %>
          <i class="fasl fa-arrow-left me-1"></i>Back to Reviewed Readings
        <% end %>
      <% else %>
        <%= link_to readings_path, class: "btn btn-outline-secondary" do %>
          <i class="fasl fa-arrow-left me-1"></i>Back to Shelf
        <% end %>
      <% end %>
      <% if policy(@reading).edit? %>
        <%= link_to edit_reading_path(@reading), class: "btn btn-outline-primary" do %>
          <i class="fasl fa-pen-to-square me-1"></i>Edit
        <% end %>
      <% end %>
      <% if policy(@reading).destroy? %>
        <%= button_to @reading, method: :delete,
              class: "btn btn-outline-danger",
              form: { data: { turbo_confirm: "Remove this reading?" } } do %>
          <i class="fasl fa-trash-can me-1"></i>Delete
        <% end %>
      <% end %>
    </div>
  </div>
</div>
