<% content_for :title, "Books" %>

<div class="d-flex justify-content-between align-items-center mb-4">
  <h1 class="mb-0">Books</h1>
  <% if signed_in? %>
    <%= link_to new_book_path, class: "btn btn-primary" do %>
      <i class="fasl fa-plus me-1"></i>Add a Book
    <% end %>
  <% end %>
</div>

<%# Without JS, the plain GET form below still works (real page loads, no client-side rendering). %>
<noscript>
  <%= form_with url: books_path, method: :get, class: "row g-2 mb-4" do |form| %>
    <div class="col-sm-8 col-md-6">
      <%= form.label :q, "Search", class: "visually-hidden" %>
      <%= form.text_field :q, value: params[:q], placeholder: "Search by title or author...", class: "form-control" %>
    </div>
    <div class="col-sm-4 col-md-3">
      <%= form.label :sort, "Sort by", class: "visually-hidden" %>
      <%= form.select :sort, BooksController::SORT_OPTIONS.map { |key, opts| [opts[:label], key] }, {selected: @sort}, class: "form-select" %>
    </div>
    <div class="col-sm-auto">
      <button type="submit" class="btn btn-outline-secondary">Search</button>
    </div>
  <% end %>

  <% if @books.any? %>
    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">
      <% @books.each do |book| %>
        <div class="col">
          <%= link_to book, class: "text-decoration-none text-dark" do %>
            <%= render book %>
          <% end %>
        </div>
      <% end %>
    </div>
    <%== @pagy.series_nav("bootstrap") if @pagy.pages > 1 %>
  <% else %>
    <div class="text-center text-muted py-5">
      <p class="fs-5">No books found.</p>
    </div>
  <% end %>
</noscript>

<div data-controller="catalog-browser"
     data-catalog-browser-initial-value="<%= @catalog_json.to_json %>"
     data-catalog-browser-query-value="<%= params[:q] %>"
     data-catalog-browser-sort-value="<%= @sort %>">
  <div data-catalog-browser-target="root"></div>
</div>
