<%= form_with(model: book, class: "needs-validation", html: { data: { controller: "book-search" } }) do |form| %>
  <%= form.hidden_field :title, data: { book_search_target: "title" } %>
  <%= form.hidden_field :author, data: { book_search_target: "author" } %>
  <%= form.hidden_field :cover_url, data: { book_search_target: "coverUrl" } %>

  <% if book.errors.any? %>
    <div class="alert alert-danger">
      <strong><%= pluralize(book.errors.count, "error") %> prevented this book from being saved:</strong>
      <ul class="mb-0 mt-1">
        <% book.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div data-book-search-target="root"></div>

  <div class="d-flex gap-2">
    <%= form.submit class: "btn btn-primary" %>
    <%= link_to "Cancel", books_path, class: "btn btn-outline-secondary" %>
  </div>
<% end %>
