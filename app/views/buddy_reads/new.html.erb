<% content_for :title, "Invite a Buddy" %>

<div class="row justify-content-center">
  <div class="col-md-7">
    <h1 class="mb-4">Invite a Buddy</h1>

    <%= form_with(model: @buddy_read) do |form| %>
      <% if @buddy_read.errors.any? %>
        <div class="alert alert-danger">
          <strong><%= pluralize(@buddy_read.errors.count, "error") %> prevented this invitation from being sent:</strong>
          <ul class="mb-0 mt-1">
            <% @buddy_read.errors.each do |error| %>
              <li><%= error.full_message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="mb-3">
        <%= form.label :book_id, "Book", class: "form-label" %>
        <%= form.collection_select :book_id, @books, :id, :title,
              { prompt: "Select a book" }, { class: "form-select" } %>
      </div>

      <div class="mb-3">
        <%= form.label :partner_id, "Buddy", class: "form-label" %>
        <%= form.collection_select :partner_id, @partners, :id, :display_name,
              { prompt: "Select a buddy" }, { class: "form-select" } %>
      </div>

      <div class="d-flex gap-2">
        <%= form.submit "Send Invitation", class: "btn btn-primary" %>
        <%= link_to "Cancel", buddy_reads_path, class: "btn btn-outline-secondary" %>
      </div>
    <% end %>
  </div>
</div>
