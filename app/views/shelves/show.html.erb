<% content_for :title, @shelf.name %>

<div class="d-flex justify-content-between align-items-center mb-4">
  <h1 class="mb-0"><%= @shelf.name %></h1>
  <div class="d-flex gap-2">
    <%= link_to shelves_path, class: "btn btn-outline-secondary" do %>
      <i class="fasl fa-arrow-left me-1"></i>Back to Lists
    <% end %>
    <%= link_to edit_shelf_path(@shelf), class: "btn btn-outline-primary" do %>
      <i class="fasl fa-pen-to-square me-1"></i>Rename
    <% end %>
    <%= button_to @shelf, method: :delete,
          class: "btn btn-outline-danger",
          form: { data: { turbo_confirm: "Delete #{@shelf.name}?" } } do %>
      <i class="fasl fa-trash-can me-1"></i>Delete
    <% end %>
  </div>
</div>

<% if @shelf_books.any? %>
  <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">
    <% @shelf_books.each do |shelf_book| %>
      <div class="col">
        <%= link_to shelf_book.book, class: "text-decoration-none text-dark" do %>
          <%= render shelf_book.book %>
        <% end %>
        <%= button_to shelf_shelf_book_path(@shelf, shelf_book), method: :delete,
              class: "btn btn-sm btn-outline-danger w-100 mt-1",
              form: { data: { turbo_confirm: "Remove \"#{shelf_book.book.title}\" from #{@shelf.name}?" } } do %>
          <i class="fasl fa-xmark me-1" aria-hidden="true"></i>Remove <span class="visually-hidden"><%= shelf_book.book.title %> </span>from this list
        <% end %>
      </div>
    <% end %>
  </div>
<% else %>
  <div class="text-center text-muted py-5">
    <p class="fs-5">No books on this list yet.</p>
    <%= link_to books_path, class: "btn btn-primary" do %>
      Browse Books
    <% end %>
  </div>
<% end %>
