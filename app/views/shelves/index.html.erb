<% content_for :title, "My Lists" %>

<div class="d-flex justify-content-between align-items-center mb-4">
  <h1 class="mb-0"><i class="fasl fa-layer-group me-2 opacity-75"></i>My Lists</h1>
  <%= link_to new_shelf_path, class: "btn btn-primary" do %>
    <i class="fasl fa-plus me-1"></i>New List
  <% end %>
</div>

<% if @shelves.any? %>
  <div class="list-group">
    <% @shelves.each do |shelf| %>
      <%= link_to shelf, class: "list-group-item list-group-item-action d-flex justify-content-between align-items-center" do %>
        <%= shelf.name %>
        <span class="badge text-bg-secondary rounded-pill"><%= shelf.shelf_books.size %></span>
      <% end %>
    <% end %>
  </div>
<% else %>
  <div class="text-center text-muted py-5">
    <p class="fs-5">You haven't created any lists yet.</p>
    <%= link_to new_shelf_path, class: "btn btn-primary" do %>
      <i class="fasl fa-plus me-1"></i>Create your first list
    <% end %>
  </div>
<% end %>
