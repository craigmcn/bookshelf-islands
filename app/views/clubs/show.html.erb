<% content_for :title, @club.name %>

<div class="card">
  <div class="card-body">
    <div class="d-flex justify-content-between align-items-start">
      <div>
        <h2 class="card-title"><%= @club.name %></h2>
        <p class="text-muted mb-1">
          Reading <%= link_to @club.book.title, @club.book, class: "text-decoration-none" %>
        </p>
        <span class="badge text-bg-secondary"><%= pluralize(@club.members.size, "member") %></span>
      </div>
      <div class="d-flex gap-2">
        <% if policy(@club).update? %>
          <%= link_to edit_club_path(@club), class: "btn btn-sm btn-outline-secondary" do %>
            <i class="fasl fa-pen" aria-hidden="true"></i><span class="visually-hidden">Edit club</span>
          <% end %>
        <% end %>
        <% if policy(@club).destroy? %>
          <%= button_to club_path(@club), method: :delete, class: "btn btn-sm btn-outline-danger",
                form: { data: { turbo_confirm: "Delete this club? This cannot be undone." } } do %>
            <i class="fasl fa-trash" aria-hidden="true"></i><span class="visually-hidden">Delete club</span>
          <% end %>
        <% end %>
      </div>
    </div>

    <% if @club.description.present? %>
      <p class="mt-3 mb-0"><%= @club.description %></p>
    <% end %>

    <div class="mt-3">
      <% if @club.member?(current_user) %>
        <%= button_to "Leave Club", club_membership_path(@club), method: :delete, class: "btn btn-outline-secondary btn-sm" %>
      <% else %>
        <%= button_to "Join Club", club_membership_path(@club), method: :post, class: "btn btn-primary btn-sm" %>
      <% end %>
    </div>
  </div>
</div>

<hr class="my-4">
<h3 class="h5"><i class="fasl fa-comments me-2 opacity-75"></i>Discussion</h3>

<% if @club_posts.any? %>
  <ul class="list-group mb-3">
    <% @club_posts.each do |post| %>
      <li class="list-group-item">
        <div class="d-flex justify-content-between align-items-start">
          <div>
            <strong><%= post.user.display_name %></strong>
            <span class="text-muted small ms-2"><%= time_ago_in_words(post.created_at) %> ago</span>
            <% if post.spoiler? %>
              <span class="badge text-bg-warning ms-2">Spoiler</span>
            <% end %>
          </div>
          <% if policy(post).destroy? %>
            <%= button_to club_post_path(@club, post), method: :delete, class: "btn btn-sm btn-outline-danger",
                  form: { data: { turbo_confirm: "Remove this post?" } } do %>
              <i class="fasl fa-trash" aria-hidden="true"></i><span class="visually-hidden">Delete post</span>
            <% end %>
          <% end %>
        </div>
        <% if post.visible_to?(current_user, viewer_has_finished_book: @viewer_has_finished_book) %>
          <p class="mb-0 mt-1"><%= post.body %></p>
        <% else %>
          <p class="mb-0 mt-1 text-muted fst-italic">
            <i class="fasl fa-eye-slash me-1"></i>Hidden until you've finished the book.
          </p>
        <% end %>
      </li>
    <% end %>
  </ul>
<% else %>
  <p class="text-muted small">No posts yet.</p>
<% end %>

<% if @club.member?(current_user) %>
  <%= form_with(model: @club_post, url: club_posts_path(@club)) do |form| %>
    <div class="mb-3">
      <%= form.label :body, "Add a post", class: "form-label" %>
      <%= form.textarea :body, class: "form-control", rows: 3 %>
    </div>
    <div class="form-check mb-3">
      <%= form.check_box :spoiler, class: "form-check-input" %>
      <%= form.label :spoiler, "Contains spoilers", class: "form-check-label" %>
    </div>
    <%= form.submit "Post", class: "btn btn-primary btn-sm" %>
  <% end %>
<% else %>
  <p class="text-muted small">Join this club to post.</p>
<% end %>
